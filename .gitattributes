# Normalise to LF in the repository. Contributors work on Windows, macOS and
# Linux, and without this a Windows checkout rewrites every file to CRLF and
# the next commit looks like the whole tree changed.
* text=auto eol=lf

# Windows-only entry points that genuinely want CRLF.
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary, so never touched.
*.png binary
*.ico binary
*.icns binary
*.prn binary

# Generated; collapse it in diffs and reviews.
pnpm-lock.yaml linguist-generated=true -diff
apps/desktop/src-tauri/Cargo.lock linguist-generated=true -diff
